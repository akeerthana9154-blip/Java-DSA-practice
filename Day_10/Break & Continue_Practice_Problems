                        =========================Break Statement==================
import java.util.*;
public class Main{
    public static void main(String args[]){
        for(int i=1;i<=20;i++){
            if(i==15){
                break;
            }
            System.out.println(i);
        }
    }
}

                       ==============================Continue Statement – Skip Even Numbers================
import java.util.*;
public class Main{
    public static void main(String args[]){
        for(int i=1;i<=20;i++){
            if(i%2==0){
                continue;
            }
            System.out.println(i);
        }
    }
}


