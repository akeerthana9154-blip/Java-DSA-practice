                       ======================Break Statement – Stop at a Number Divisible by 5 and 7=====================
import java.util.*;
public class Main{
    public static void main(String args[]){
        for(int i=1;i<=100;i++){
            if(i%7==0 && i%5==0){
                break;
            }
            System.out.println(i);
        }
    }
}
